{
  "name": "picktranslator",
  "version": "2.0.0",
  "description": "Cross-platform pick-to-translate menu bar app (macOS / Windows)",
  "main": "dist/main/index.js",
  "license": "MIT",
  "scripts": {
    "build": "node esbuild.mjs",
    "start": "npm run build && electron .",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win",
    "pack:all": "npm run build && electron-builder --mac --win"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}